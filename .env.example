# Copy to .env before running `docker compose up` for Production.

# PostgreSQL (Production)
POSTGRES_DB=gimel
POSTGRES_USER=gimel
POSTGRES_PASSWORD=replace-with-strong-db-password

# Gimel Production Security (generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))")
GIMEL_SECRET_KEY=
GIMEL_ALLOWED_HOSTS=127.0.0.1,localhost
# Restrict HTTP/WebSocket access to loopback & private LAN (RFC1918/ULA/link-local) only
GIMEL_LOCALNET_ONLY=1
GIMEL_LOCALNET_ALLOW=

# Initial Production Admin Account (username + password, created once on empty DB; min. 8 chars)
# Leave empty to create the first admin interactively in the browser on first visit.
GIMEL_ADMIN_USER=admin
GIMEL_ADMIN_PASSWORD=replace-with-strong-password

# Optional features (disabled by default)
GIMEL_ENABLE_ROBOTS=0
